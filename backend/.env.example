# =====================================================================
#  DriveBEM Backend — salin file ini menjadi `backend/.env`
# =====================================================================

NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------------
# Database (PostgreSQL / Supabase)
# ---------------------------------------------------------------------
# PostgreSQL lokal:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/drivebem?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/drivebem?schema=public"
#
# Supabase (Project Settings → Database → Connection string):
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------
# Keamanan
# ---------------------------------------------------------------------
JWT_SECRET="ganti-dengan-string-acak-panjang-minimal-32-karakter"
JWT_EXPIRES_IN=7d
# Kunci enkripsi Access/Secret Key bucket di database (JANGAN diubah setelah bucket dibuat)
ENCRYPTION_KEY="ganti-dengan-string-acak-lain-minimal-32-karakter"

# Origin frontend yang diizinkan (pisahkan dengan koma)
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------
# Upload
# ---------------------------------------------------------------------
# Batas ukuran per file (MB)
MAX_FILE_SIZE_MB=5120
# Masa berlaku Presigned URL (detik)
PRESIGNED_URL_EXPIRES=900

# ---------------------------------------------------------------------
# Local Disk Storage Fallback
#   true  → aplikasi langsung bisa dicoba tanpa kredensial S3/R2/B2.
#           File disimpan di LOCAL_STORAGE_PATH dan bucket "Local Disk" otomatis dibuat.
#           Bila ada bucket S3 aktif, bucket S3 selalu didahulukan.
#   false → hanya memakai bucket S3-compatible dari menu Manajemen Bucket.
# ---------------------------------------------------------------------
LOCAL_STORAGE_ENABLED=true
LOCAL_STORAGE_PATH=./uploads
LOCAL_STORAGE_CAPACITY_GB=500

# Base URL publik backend untuk URL upload/download Local Disk.
# Kosongkan bila frontend memakai proxy /api (dev Vite / backend menyajikan frontend).
# Isi bila frontend & backend beda domain, contoh: https://api.drive-bem.id
PUBLIC_API_URL=

# ---------------------------------------------------------------------
# Akun Admin default untuk seed
# ---------------------------------------------------------------------
SEED_ADMIN_NAME="Administrator"
SEED_ADMIN_EMAIL=admin@drive.local
SEED_ADMIN_PASSWORD=admin123
