# =====================================================================
#  DriveBEM — Contoh Konfigurasi Environment (.env)
#  Salin file ini ke `backend/.env` sebelum menjalankan backend.
# =====================================================================

NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------------
# 1. Database PostgreSQL (Lokal atau Supabase)
# ---------------------------------------------------------------------
# Contoh PostgreSQL Lokal:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/drivebem?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/drivebem?schema=public"

# Contoh Supabase (Session / Transaction Pooler + Direct Connection):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------
# 2. JWT & Enkripsi Kredensial Storage Bucket
# ---------------------------------------------------------------------
JWT_SECRET="ganti-dengan-random-string-minimal-32-karakter"
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY="ganti-dengan-random-encryption-key-32-karakter"

# Origin Frontend (CORS)
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------
# 3. Pengaturan Upload & Presigned URL
# ---------------------------------------------------------------------
MAX_FILE_SIZE_MB=5120
PRESIGNED_URL_EXPIRES=900

# ---------------------------------------------------------------------
# 4. Local Disk Storage Fallback
#    Ketika LOCAL_STORAGE_ENABLED=true, aplikasi otomatis menyiapkan
#    bucket "Local Disk (Fallback)" sehingga bisa langsung diuji coba
#    tanpa harus memasukkan kredensial S3/R2/B2 terlebih dahulu.
# ---------------------------------------------------------------------
LOCAL_STORAGE_ENABLED=true
LOCAL_STORAGE_PATH=./uploads
LOCAL_STORAGE_CAPACITY_GB=500
PUBLIC_API_URL=

# ---------------------------------------------------------------------
# 5. Akun Default Saat Menjalankan `npm run db:seed`
# ---------------------------------------------------------------------
SEED_ADMIN_NAME="Administrator"
SEED_ADMIN_EMAIL=admin@drive.local
SEED_ADMIN_PASSWORD=admin123
